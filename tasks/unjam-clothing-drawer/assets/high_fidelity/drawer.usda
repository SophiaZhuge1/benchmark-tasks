#usda 1.0
(
    defaultPrim = "Drawer"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Drawer" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
    doc = "Empty drawer development asset. One compound rigid body, constrained to world by a passive rail. World anchor is fixed to station pose (0.46, 0.04, 0.8125); single environment only. No clothing."
)
{
    float physics:mass = 0.35
    bool physics:rigidBodyEnabled = 1
    float physxRigidBody:angularDamping = 0.5
    float physxRigidBody:linearDamping = 1
    float physxRigidBody:maxLinearVelocity = 0.5

    def Material "Wood" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        token outputs:surface.connect = </Drawer/Wood/Surface.outputs:surface>
        float physics:dynamicFriction = 0.48
        float physics:restitution = 0
        float physics:staticFriction = 0.6

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.65, 0.43, 0.24)
            float inputs:roughness = 0.55
            token outputs:surface
        }
    }

    def Material "HandleMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        token outputs:surface.connect = </Drawer/HandleMaterial/Surface.outputs:surface>
        float physics:dynamicFriction = 0.8
        float physics:restitution = 0
        float physics:staticFriction = 1

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.035, 0.3, 0.7)
            float inputs:roughness = 0.55
            token outputs:surface
        }
    }

    def Cube "Floor" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        rel material:binding = </Drawer/Wood>
        rel material:binding:physics = </Drawer/Wood>
        float physxCollision:contactOffset = 0.001
        float physxCollision:restOffset = 0
        double size = 1
        token visibility = "invisible"
        float3 xformOp:scale = (0.228, 0.24, 0.012)
        double3 xformOp:translate = (0, 0, -0.041)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Front" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        rel material:binding = </Drawer/Wood>
        rel material:binding:physics = </Drawer/Wood>
        float physxCollision:contactOffset = 0.001
        float physxCollision:restOffset = 0
        double size = 1
        token visibility = "invisible"
        float3 xformOp:scale = (0.012, 0.24, 0.07)
        double3 xformOp:translate = (-0.114, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Back" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        rel material:binding = </Drawer/Wood>
        rel material:binding:physics = </Drawer/Wood>
        float physxCollision:contactOffset = 0.001
        float physxCollision:restOffset = 0
        double size = 1
        token visibility = "invisible"
        float3 xformOp:scale = (0.012, 0.24, 0.07)
        double3 xformOp:translate = (0.114, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Left" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        rel material:binding = </Drawer/Wood>
        rel material:binding:physics = </Drawer/Wood>
        float physxCollision:contactOffset = 0.001
        float physxCollision:restOffset = 0
        double size = 1
        token visibility = "invisible"
        float3 xformOp:scale = (0.216, 0.012, 0.07)
        double3 xformOp:translate = (0, 0.114, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Right" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        rel material:binding = </Drawer/Wood>
        rel material:binding:physics = </Drawer/Wood>
        float physxCollision:contactOffset = 0.001
        float physxCollision:restOffset = 0
        double size = 1
        token visibility = "invisible"
        float3 xformOp:scale = (0.216, 0.012, 0.07)
        double3 xformOp:translate = (0, -0.114, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "HandleStem" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        rel material:binding = </Drawer/HandleMaterial>
        rel material:binding:physics = </Drawer/HandleMaterial>
        float physxCollision:contactOffset = 0.001
        float physxCollision:restOffset = 0
        double size = 1
        token visibility = "invisible"
        float3 xformOp:scale = (0.056, 0.012, 0.012)
        double3 xformOp:translate = (-0.145, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Handle" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        rel material:binding = </Drawer/HandleMaterial>
        rel material:binding:physics = </Drawer/HandleMaterial>
        float physxCollision:contactOffset = 0.001
        float physxCollision:restOffset = 0
        double size = 1
        token visibility = "invisible"
        float3 xformOp:scale = (0.026, 0.032, 0.026)
        double3 xformOp:translate = (-0.18, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def PhysicsPrismaticJoint "Rail"
    {
        uniform token physics:axis = "X"
        rel physics:body0 = None
        rel physics:body1 = </Drawer>
        uniform bool physics:excludeFromArticulation = 1
        bool physics:jointEnabled = 1
        point3f physics:localPos0 = (0.46, 0.04, 0.8125)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
        float physics:lowerLimit = -0.16
        float physics:upperLimit = 0
    }

    def "Looks"
    {
        def Material "Oak"
        {
            token outputs:surface.connect = </Drawer/Looks/Oak/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0.16
                float inputs:clearcoatRoughness = 0.3
                color3f inputs:diffuseColor = (0.49, 0.27, 0.11)
                color3f inputs:diffuseColor.connect = </Drawer/Looks/Oak/diffuseColorTexture.outputs:rgb>
                normal3f inputs:normal.connect = </Drawer/Looks/Oak/normalTexture.outputs:rgb>
                float inputs:roughness = 0.43
                float inputs:roughness.connect = </Drawer/Looks/Oak/roughnessTexture.outputs:r>
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "diffuseColorTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/oak_basecolor.png@
                float4 inputs:scale = (1, 1, 1, 1)
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Drawer/Looks/Oak/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "roughnessTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/oak_roughness.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Drawer/Looks/Oak/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }

            def Shader "normalTexture"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, 0)
                asset inputs:file = @textures/oak_normal.png@
                float4 inputs:scale = (2, 2, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Drawer/Looks/Oak/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "Interior"
        {
            token outputs:surface.connect = </Drawer/Looks/Interior/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0.16
                float inputs:clearcoatRoughness = 0.3
                color3f inputs:diffuseColor = (0.49, 0.27, 0.11)
                color3f inputs:diffuseColor.connect = </Drawer/Looks/Interior/diffuseColorTexture.outputs:rgb>
                normal3f inputs:normal.connect = </Drawer/Looks/Interior/normalTexture.outputs:rgb>
                float inputs:roughness = 0.43
                float inputs:roughness.connect = </Drawer/Looks/Interior/roughnessTexture.outputs:r>
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "diffuseColorTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/oak_basecolor.png@
                float4 inputs:scale = (1.1, 1.1, 1.12, 1)
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Drawer/Looks/Interior/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "roughnessTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/oak_roughness.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Drawer/Looks/Interior/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }

            def Shader "normalTexture"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, 0)
                asset inputs:file = @textures/oak_normal.png@
                float4 inputs:scale = (2, 2, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Drawer/Looks/Interior/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "BlueFinish"
        {
            token outputs:surface.connect = </Drawer/Looks/BlueFinish/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0.25
                float inputs:clearcoatRoughness = 0.23
                color3f inputs:diffuseColor = (0.025, 0.2, 0.46)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }

        def Material "Steel"
        {
            token outputs:surface.connect = </Drawer/Looks/Steel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.56, 0.6, 0.65)
                float inputs:metallic = 0.95
                float inputs:roughness = 0.24
                token outputs:surface
            }
        }

        def Material "Slot"
        {
            token outputs:surface.connect = </Drawer/Looks/Slot/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.035, 0.04, 0.045)
                float inputs:metallic = 0.95
                float inputs:roughness = 0.24
                token outputs:surface
            }
        }
    }

    def Mesh "Visual_Floor" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.114, -0.12, -0.047), (0.114, 0.12, -0.035)]
        int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3