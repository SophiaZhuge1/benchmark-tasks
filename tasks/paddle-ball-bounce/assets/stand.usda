#usda 1.0
(
    defaultPrim = "Stand"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Stand" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI"]
)
{
    bool physics:kinematicEnabled = 1

    def Material "Wood" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:staticFriction = 0.6000
        float physics:dynamicFriction = 0.5000
        float physics:restitution = 0.2000
    }

    def Cube "collider" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Stand/Wood>
        uniform token purpose = "guide"
        double size = 1
        float physxCollision:contactOffset = 0.002
        float physxCollision:restOffset = 0
        double3 xformOp:translate = (0.000000, 0.000000, 0.030000)
        quatf xformOp:orient = (1.000000, 0.000000, 0.000000, 0.000000)
        float3 xformOp:scale = (0.120000, 0.090000, 0.060000)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Scope "Looks"
    {
        def Material "stand_wood"
        {
            token outputs:surface.connect = </Stand/Looks/stand_wood/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.45, 0.3, 0.17)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

