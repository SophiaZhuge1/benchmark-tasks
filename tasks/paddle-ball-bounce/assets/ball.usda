#usda 1.0
(
    defaultPrim = "Ball"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Ball" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI", "PhysxContactReportAPI"]
)
{
    float physics:mass = 0.0027
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (7.200e-07, 7.200e-07, 7.200e-07)
    float physxRigidBody:sleepThreshold = 0
    float physxRigidBody:stabilizationThreshold = 0
    float physxRigidBody:linearDamping = 0.26
    float physxRigidBody:angularDamping = 0.02
    float physxRigidBody:maxDepenetrationVelocity = 1
    int physxRigidBody:solverPositionIterationCount = 16
    int physxRigidBody:solverVelocityIterationCount = 4
    float physxContactReport:threshold = 0

    def Material "Celluloid" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:staticFriction = 0.9000
        float physics:dynamicFriction = 0.9000
        float physics:restitution = 0.8500
    }

    def Scope "Looks"
    {
        def Material "ball"
        {
            token outputs:surface.connect = </Ball/Looks/ball/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.92, 0.92, 0.9)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
    }

    def Sphere "collider" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        double radius = 0.02
        rel material:binding = </Ball/Looks/ball>
        rel material:binding:physics = </Ball/Celluloid>
        float physxCollision:contactOffset = 0.002
        float physxCollision:restOffset = 0
    }
}
